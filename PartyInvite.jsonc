{
  "name": "PartyInvite",
  "type": "object",
  "properties": {
    "from_user_id": {
      "type": "string"
    },
    "to_user_id": {
      "type": "string"
    },
    "from_username": {
      "type": "string"
    },
    "to_username": {
      "type": "string"
    },
    "party_id": {
      "type": "string"
    },
    "party_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined"
      ],
      "default": "pending"
    }
  },
  "required": [
    "from_user_id",
    "to_user_id",
    "status"
  ],
  "rls": {
    "read": true,
    "write": true
  }
}