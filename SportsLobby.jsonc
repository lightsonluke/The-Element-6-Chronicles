{
  "name": "SportsLobby",
  "type": "object",
  "properties": {
    "sport": {
      "type": "string",
      "enum": [
        "soccer",
        "volleyball",
        "baseball",
        "dodgeball",
        "banger"
      ],
      "default": "soccer"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "playing",
        "closed"
      ],
      "default": "open"
    },
    "host_user_id": {
      "type": "string"
    },
    "host_username": {
      "type": "string"
    },
    "host_char": {
      "type": "string"
    },
    "host_element": {
      "type": "string",
      "default": "basic"
    },
    "host_ready": {
      "type": "boolean",
      "default": false
    },
    "guest_user_id": {
      "type": "string"
    },
    "guest_username": {
      "type": "string"
    },
    "guest_char": {
      "type": "string"
    },
    "guest_element": {
      "type": "string",
      "default": "basic"
    },
    "guest_ready": {
      "type": "boolean",
      "default": false
    },
    "match_settings": {
      "type": "object"
    },
    "room_code": {
      "type": "string"
    },
    "winner": {
      "type": "string",
      "default": "none"
    },
    "host_score": {
      "type": "number",
      "default": 0
    },
    "guest_score": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "sport",
    "status",
    "host_user_id",
    "room_code"
  ],
  "rls": {
    "read": true,
    "write": true
  }
}