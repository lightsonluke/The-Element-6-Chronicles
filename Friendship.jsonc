{
  "name": "Friendship",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string"
    },
    "friend_user_id": {
      "type": "string"
    },
    "friend_username": {
      "type": "string"
    },
    "friend_code": {
      "type": "string"
    },
    "is_favorite": {
      "type": "boolean",
      "default": false
    },
    "is_ignored": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "owner_user_id",
    "friend_user_id"
  ],
  "rls": {
    "read": true,
    "write": true
  }
}